{
  "expo": {
    "name": "Simple OTP",
    "slug": "simple-otp",
    "version": "0.0.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "simpleotp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "vn.io.kd.simpleotp",
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleLocalizations": [
          "vi",
          "en"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "vn.io.kd.simpleotp",
      "adaptiveIcon": {
        "backgroundColor": "#F76B00",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F76B00",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Simple OTP to access your camera to scan 2FA QR codes.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Simple OTP to access your photos to import 2FA QR codes from images."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Simple OTP to use Face ID to unlock your 2FA vault."
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "vi",
              "en"
            ],
            "android": [
              "vi",
              "en"
            ]
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1d1080bb-bc1e-4e1e-9096-7a8860bc6607"
      }
    },
    "owner": "kd-labs-app"
  }
}
